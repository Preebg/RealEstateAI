# CapEigen API reverse proxy — run from the repo root on the host machine:
#   caddy run --config Caddyfile
#
# Public SPA is served by the Cloudflare Worker (capeigen.preebg.dev).
# Cloudflare Tunnel should point only the API hostname here:
#   api.capeigen.preebg.dev → http://localhost:80
#
# /api/* goes through the always-on wake proxy (scripts/run_wake_proxy.cmd),
# which starts Docker only when a request arrives.
# Do NOT serve the SPA from this host — marketing pages must work when
# Caddy/Docker are offline.

:80 {
	# /api/* matches only one segment (e.g. /api/health). Nested routes like
	# /api/legal/acceptance need /api* or they hit the catch-all.
	handle /api* {
		reverse_proxy 127.0.0.1:8088
	}

	handle {
		respond "CapEigen API origin. Use https://capeigen.preebg.dev for the app." 404
	}
}
