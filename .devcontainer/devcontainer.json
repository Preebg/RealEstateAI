{
  "name": "CapEigen (API + Web)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "api/main.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint"
      ]
    }
  },
  "updateContentCommand": "[ -f packages.txt ] && sudo apt update && sudo apt upgrade -y && sudo xargs apt install -y <packages.txt; [ -f requirements.txt ] && pip3 install --user -r requirements.txt; cd web && npm install; echo '✅ Packages installed'",
  "postAttachCommand": {
    "api": "uvicorn api.main:app --reload --host 0.0.0.0 --port 8000",
    "web": "cd web && npm run dev -- --host 0.0.0.0 --port 5173"
  },
  "portsAttributes": {
    "8000": {
      "label": "CapEigen API",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "CapEigen Web",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8000,
    5173
  ]
}
