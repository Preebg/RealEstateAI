VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Google Cloud → APIs & Services → Credentials → Web client ID (public)
# Authorized JavaScript origins:
#   https://capeigen.preebg.dev
#   http://localhost:5173
# Authorized redirect URIs (replace the supabase.co callback for CapEigen login):
#   https://capeigen.preebg.dev/auth/google/callback
#   http://localhost:5173/auth/google/callback
VITE_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Leave empty for local Vite (/api proxy) or Netlify portfolio-via-Supabase.
# Set to your public FastAPI URL for Search / analysis on a deployed site.
VITE_API_URL=
