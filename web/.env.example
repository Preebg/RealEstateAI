VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Google Cloud → APIs & Services → Credentials → Web client ID
# Authorized JavaScript origins: https://your-domain , http://localhost:5173
# Authorized redirect URIs (required for CapEigen-branded Google login):
#   https://your-domain/auth/google/callback
#   http://localhost:5173/auth/google/callback
# Keep https://YOUR_REF.supabase.co/auth/v1/callback only if you still need legacy Supabase OAuth.
VITE_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Leave empty for local Vite (/api proxy) or Netlify portfolio-via-Supabase.
# Set to your public FastAPI URL for Search / analysis on a deployed site.
VITE_API_URL=
