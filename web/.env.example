VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Google Cloud Web client ID (public). Also set on Netlify:
#   GOOGLE_WEB_CLIENT_ID=<same>
#   GOOGLE_WEB_CLIENT_SECRET=<secret from Google Cloud>
# Authorized redirect URI: https://your-domain/auth/google/callback
VITE_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Leave empty for local Vite (/api proxy). Set for Search/analysis API host.
VITE_API_URL=
