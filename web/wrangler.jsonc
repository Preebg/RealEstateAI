{
  "name": "capeigen",
  "main": "./worker.js",
  "compatibility_date": "2026-08-15",
  "vars": {
    "API_URL": "https://capeigen.preebg.dev"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/auth/*"]
  },
  "observability": {
    "enabled": true
  }
}
