# CapEigen local / Docker API environment
# Copy to .env and fill in real values (never commit .env)

# --- Auth (stays on Supabase even when data is local) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_AUTH_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_USER_ID=

# --- Self-hosted data (harvest machine) ---
# When set, FastAPI + harvester read/write local Postgres via PostgREST gateway.
# Leave unset to keep using hosted Supabase for data.
# Host shell / harvester (required for Task Scheduler on the harvest machine):
DATABASE_REST_URL=http://127.0.0.1:3001
# API container (compose default): http://rest-gateway:3001
# DATABASE_REST_URL_DOCKER=http://rest-gateway:3001

POSTGRES_DB=capeigen
POSTGRES_USER=capeigen
POSTGRES_PASSWORD=capeigen
POSTGRES_PORT=5432
DATABASE_REST_PORT=3001

# --- Energy / on-demand Docker (harvest machine) ---
# Default: stack starts on demand (wake proxy / harvester) and stops when idle.
# STACK_ALWAYS_ON=1
# STACK_IDLE_MINUTES=30
# STACK_STOP_DOCKER=1
# STACK_RESTART_POLICY=unless-stopped

GEMINI_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://capeigen.preebg.dev
# After Pages is live, also include the SPA origin, e.g. https://capeigen.pages.dev
# Preview deploys (*.pages.dev) are already allowed by api/main.py origin regex.

# Google Web OAuth client (CapEigen redirect URIs — not supabase.co)
# Authorized redirect URIs:
#   https://capeigen.preebg.dev/auth/google/callback
#   http://localhost:5173/auth/google/callback
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_SECRET=your-web-client-secret

# Fallback preview usernames if the admin dashboard table is empty.
# Prefer adding/removing names while signed in as preebg09@gmail.com at /activity.
# DEMO_USERNAMES=salifT,anotherUser
# Hosted Auth admin key if SUPABASE_SERVICE_ROLE_KEY is the local PostgREST dummy.
# Required for scripts/migrate_supabase_to_local.py in that case (JWT starts with eyJ).
# SUPABASE_AUTH_SERVICE_ROLE_KEY=
