# CapEigen local / Docker API environment
# Copy to .env and fill in real values (never commit .env)

# --- Auth (stays on Supabase even when data is local) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_AUTH_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_USER_ID=

# --- Self-hosted data (harvest machine) ---
# When set, FastAPI + harvester read/write local Postgres via PostgREST gateway.
# Leave unset to keep using hosted Supabase for data.
# Host shell / harvester on the host: http://127.0.0.1:3001
# API container (docker compose sets this automatically): http://rest-gateway:3001
# DATABASE_REST_URL=http://127.0.0.1:3001

POSTGRES_DB=capeigen
POSTGRES_USER=capeigen
POSTGRES_PASSWORD=capeigen
POSTGRES_PORT=5432
DATABASE_REST_PORT=3001

GEMINI_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google Web OAuth client (CapEigen redirect URIs — not supabase.co)
# Authorized redirect URIs:
#   https://capeigen.preebg.dev/auth/google/callback
#   http://localhost:5173/auth/google/callback
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_SECRET=your-web-client-secret
